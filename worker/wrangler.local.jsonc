{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clashking-discord-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "ip": "127.0.0.1", "port": 8788 },
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "dev",
    "DASHBOARD_BASE_URL": "https://local-dash.clashk.ing",
    "CLASHKING_API_BASE_URL": "http://127.0.0.1:8787",
    "LOCAL_TEST_USER_ID": ""
  }
}
