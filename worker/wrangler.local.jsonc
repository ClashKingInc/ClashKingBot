{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clashking-discord-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "dev",
    "CLASHKING_API_BASE_URL": "https://api.clashk.ing"
  }
}
